# Copy to .env.local (development) or set these on your host (production).

# The backend's address. Every page reads its content from <API_URL>/api/v1, at build time and when
# refreshing. The backend must be reachable while `next build` runs.
# Development default: http://localhost:4000
API_URL=https://api.example.com

# Shared with the backend (set the same value as its REVALIDATE_SECRET, and set its
# WEBSITE_REVALIDATE_URL to https://<this site>/api/revalidate). Lets a save in the dashboard show
# on the website straight away. At least 32 characters: openssl rand -base64 48
REVALIDATE_SECRET=

# Fallback: seconds before cached content is refreshed even without a notice from the backend.
CONTENT_REVALIDATE_SECONDS=300

# The site's public address, e.g. https://example.com. Used for canonical URLs, og:url, robots.txt and
# sitemap.xml. Without it those are left out (never guessed).
SITE_URL=
