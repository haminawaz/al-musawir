# Copy to .env.local (development) or set these on your host (production).

# The backend's address. The dashboard forwards its /api requests there (to <API_URL>/api/admin).
# Read when the server starts, so changing it needs a restart, not a rebuild.
# Development default: http://localhost:4000
API_URL=https://api.example.com

# The public website, for the "View website" link. Built into the page, so changing it needs a rebuild.
NEXT_PUBLIC_SITE_URL=https://example.com
