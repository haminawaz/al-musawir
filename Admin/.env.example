# Copy to .env.local and change the values.

# Mock login. In production both ADMIN_PASSWORD and AUTH_SECRET must be set, or sign-in is refused.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Admin

# Signs the session cookie. Use a long random string, e.g. `openssl rand -base64 32`.
AUTH_SECRET=

# Where the dashboard sends API requests. Leave empty to use the mock API in this app (/api).
# When the real backend is ready, set it to the backend's URL, e.g. https://api.example.com
NEXT_PUBLIC_API_URL=

# The public website, used by the "View site" link.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: where the mock API keeps its data. Defaults to ./.mock-db.json
# MOCK_DB_PATH=
