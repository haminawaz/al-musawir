# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Behind a proxy or load balancer, the number of proxies in front (e.g. 1), so rate limits see the client's IP.
TRUST_PROXY=false
# Largest JSON body the admin API accepts.
BODY_LIMIT=256kb

# --- Database (PostgreSQL) -----------------------------------------------
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/al_musawir?schema=public
# Optional: separate connection for the public API, e.g. a role with SELECT only, or a read replica.
# Leave empty to use DATABASE_URL (the public API's connections are still opened read-only).
DATABASE_READONLY_URL=
DATABASE_POOL_MAX=10
# Opens public-API connections with default_transaction_read_only=on. Set to false only if your
# connection pooler (e.g. PgBouncer, some hosted poolers) rejects startup options.
PUBLIC_DB_READ_ONLY_SESSION=true

# Only for the optional local database in docker-compose.yml. Match DATABASE_URL to these.
POSTGRES_USER=al_musawir
POSTGRES_PASSWORD=
POSTGRES_DB=al_musawir
POSTGRES_PORT=5432

# --- Admin sign-in ------------------------------------------------------------
# Signs the session cookie. At least 32 characters; generate with: openssl rand -base64 48
# Changing it signs the admin out everywhere.
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-characters
SESSION_COOKIE_NAME=am_admin_session
SESSION_TTL_HOURS=8
# Defaults to true when NODE_ENV=production. Must be true in production.
COOKIE_SECURE=
# lax works when the dashboard and the API share a site (e.g. admin.example.com and api.example.com).
# Use none (with COOKIE_SECURE=true) only if they are on different sites.
COOKIE_SAMESITE=lax
# Optional, e.g. .example.com. Leave empty to scope the cookie to this API's host.
COOKIE_DOMAIN=

# The one admin account, created by `npm run db:seed` when none exists yet.
# Password: at least 12 characters. Afterwards you can remove ADMIN_PASSWORD from .env;
# change the account with `npm run admin:set`.
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_PASSWORD=

# --- CORS ------------------------------------------------------------------------
# The dashboard's public URL (comma-separated if several). Changes from any other origin are refused.
ADMIN_CORS_ORIGINS=http://localhost:3001
PUBLIC_CORS_ORIGINS=*

# --- Website refresh after a save (optional, recommended) ------------------------
# The website's revalidation endpoint, and a secret shared with it (its REVALIDATE_SECRET).
# Without these the website still refreshes on its own timer (its CONTENT_REVALIDATE_SECONDS).
WEBSITE_REVALIDATE_URL=
REVALIDATE_SECRET=

# --- Public API performance and limits -------------------------------------------
PUBLIC_CACHE_TTL_SECONDS=60
PUBLIC_RATE_LIMIT_PER_MINUTE=300
# Dashboard requests all arrive from the dashboard's server, so this is shared by the whole dashboard.
ADMIN_RATE_LIMIT_PER_MINUTE=1000
LOGIN_RATE_LIMIT_PER_15_MINUTES=10
LOGIN_GLOBAL_RATE_LIMIT_PER_15_MINUTES=50
